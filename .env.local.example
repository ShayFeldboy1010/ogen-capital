# Newsletter delivery (src/app/api/subscribe/route.ts).
# Copy this file to .env.local for local dev, and set the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# API key from https://resend.com (starts with "re_").
RESEND_API_KEY=

# Sender. The domain must be verified in Resend. Until ogen.capital is
# verified there, use Resend's sandbox sender: OGen <onboarding@resend.dev>
NEWSLETTER_FROM=OGen <onboarding@resend.dev>

# Who receives each signup. Comma-separated.
NEWSLETTER_TO=dooby@ogen.capital,gil@ogen.capital
